<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title style="font-size: 22px">Welcome to LifeLine Dispatch</title>

    <style>
      @media only screen and (max-width: 600px) {
        .email-container {
          width: 100% !important;
          max-width: 100% !important;
          border-radius: 0 !important;
        }

        .header-padding {
          padding: 18px 18px 8px !important;
        }

        .logo-box {
          width: 40px !important;
          height: 40px !important;
        }

        .logo-text {
          font-size: 14px !important;
        }

        .brand-title {
          font-size: 20px !important;
          line-height: 22px !important;
        }

        .date-text {
          font-size: 11px !important;
        }

        .success-icon {
          width: 60px !important;
          height: 60px !important;
        }

        .success-check {
          font-size: 30px !important;
        }

        .main-title {
          font-size: 22px !important;
          line-height: 29px !important;
        }

        .subtitle {
          padding: 0 20px 25px !important;
          font-size: 14px !important;
          line-height: 21px !important;
        }

        .body-section {
          padding: 0 20px !important;
          font-size: 14px !important;
          line-height: 23px !important;
        }

        .welcome-box {
          padding: 0 20px 25px !important;
        }

        .welcome-box-content {
          padding: 18px !important;
          font-size: 13px !important;
          line-height: 21px !important;
        }

        .welcome-title {
          font-size: 15px !important;
        }

        .footer-text {
          font-size: 12px !important;
          line-height: 18px !important;
        }
      }
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      role="presentation"
      style="width: 100%; background-color: #ffffff"
    >
      <tr>
        <td align="center" style="padding: 25px 10px">
          <!-- Main Email Container -->
          <table
            width="700"
            border="0"
            cellspacing="0"
            cellpadding="0"
            role="presentation"
            style="
              width: 100%;
              max-width: 700px;
              background-color: #f3f4fa;
              border-radius: 10px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td class="header-padding" style="padding: 25px 30px 10px">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                >
                  <tr>
                    <td align="left" valign="middle">
                      <table
                        border="0"
                        cellspacing="0"
                        cellpadding="0"
                        role="presentation"
                      >
                        <tr>
                          <!-- Logo -->
                          <td valign="middle" style="padding-right: 12px">
                            <table
                              width="40"
                              height="40"
                              border="0"
                              cellspacing="0"
                              cellpadding="0"
                              role="presentation"
                              style="
                                width: 40px;
                                height: 40px;
                                background-color: #7c3aed;
                                border-radius: 10px;
                              "
                            >
                              <tr>
                                <td
                                  align="center"
                                  valign="middle"
                                  style="
                                    color: #ffffff;
                                    font-size: 16px;
                                    font-weight: 700;
                                  "
                                >
                                  LD
                                </td>
                              </tr>
                            </table>
                          </td>

                          <!-- Brand -->
                          <td
                            valign="middle"
                            style="
                              color: #191355;
                              font-size: 16px;
                              font-weight: 700;
                              line-height: 15px;
                            "
                          >
                            LifeLine Dispatch
                          </td>
                        </tr>
                      </table>
                    </td>

                    <!-- Date -->
                    <td
                      align="right"
                      valign="top"
                      style="
                        padding-top: 12px;
                        color: #a3a3a3;
                        font-size: 10px;
                        font-weight: 600;
                      "
                    >
                      <%= new Date().toLocaleDateString("en-GB") %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Success Icon -->
            <tr>
              <td align="center" style="padding: 38px 20px 15px">
                <table
                  width="65"
                  height="65"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                  style="
                    width: 65px;
                    height: 65px;
                    background-color: #22c55e;
                    border-radius: 50%;
                  "
                >
                  <tr>
                    <td
                      align="center"
                      valign="middle"
                      class="success-check"
                      style="color: #ffffff; font-size: 38px; font-weight: 700"
                    >
                      ✓
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Heading -->
            <tr>
              <td align="center" style="padding: 10px">
                <div
                  style="
                    color: #08275d;
                    font-size: 19px;
                    line-height: 15px;
                    font-weight: 700;
                  "
                >
                  Welcome to LifeLine Dispatch!
                </div>
              </td>
            </tr>

            <!-- Sub Heading -->
            <tr>
              <td
                align="center"
                style="
                  padding: 8px;
                  color: #697386;
                  font-size: 14px;
                  line-height: 18px;
                "
              >
                Your email has been successfully verified.
                <br />
                Your account is now ready to use.
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td
                style="
                  margin-top: 15px;
                  padding: 0 32px;
                  color: #111111;
                  font-size: 14px;
                  line-height: 1.6;
                " 
              >
                <p style="margin: 18px 0 8px">
                  Dear <strong><%= name %></strong>,
                </p>

                <p style="margin: 0 0 18px">
                  Welcome to
                  <strong>LifeLine Dispatch!</strong>
                  We are pleased to let you know that your email verification
                  has been completed successfully.
                </p>

                <p style="margin: 0 0 18px">
                  Your registered email is:
                  <strong style="color: #08275d"><%= email %></strong>
                </p>

                <p style="margin: 0 0 25px">
                  You can now securely access your account and use the available
                  LifeLine Dispatch services on our platform.
                </p>
              </td>
            </tr>

            <!-- Welcome Box -->
            <tr>
              <td class="welcome-box" style="padding: 0 45px 30px">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                  style="
                    width: 100%;
                    background-color: #ffffff;
                    border: 1px solid #e1e5ef;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td
                      style="
                        padding: 20px 24px;
                        color: #333333;
                        font-size: 14px;
                        line-height: 1.6;
                      "
                    >
                      <strong
                        style="
                          display: block;
                          margin-bottom: 10px;
                          color: #08275d;
                          font-size: 14px;
                        "
                      >
                        Your account is ready
                      </strong>

                      ✓ Email successfully verified
                      <br />

                      ✓ Account successfully activated
                      <br />

                      ✓ Secure access enabled
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Thank You -->
            <tr>
              <td
                style="
                  padding: 0 45px 35px;
                  color: #111111;
                  font-size: 14px;
                  line-height: 1.6;
                "
              >
                <p style="margin: 0 0 18px">
                  We are glad to have you with us and look forward to providing
                  you with a secure and convenient emergency response
                  experience.
                </p>

                <p style="margin: 0">
                  Regards,
                  <br />
                  <strong>Team LifeLine Dispatch </strong>
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0">
                <div
                  style="width: 100%; height: 1px; background-color: #b5b5b5"
                ></div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 24px 30px 30px">
                <!-- Social -->
                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                  style="margin: 0 auto"
                >
                  <tr>
                    <td style="padding: 0 6px">
                      <div
                        style="
                          width: 32px;
                          height: 32px;
                          line-height: 32px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 18px;
                          font-weight: 700;
                          text-align: center;
                        "
                      >
                        f
                      </div>
                    </td>

                    <td style="padding: 0 6px">
                      <div
                        style="
                          width: 32px;
                          height: 32px;
                          line-height: 32px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 13px;
                          text-align: center;
                        "
                      >
                        ▶
                      </div>
                    </td>

                    <td style="padding: 0 6px">
                      <div
                        style="
                          width: 32px;
                          height: 32px;
                          line-height: 32px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 14px;
                          font-weight: 700;
                          text-align: center;
                        "
                      >
                        in
                      </div>
                    </td>

                    <td style="padding: 0 6px">
                      <div
                        style="
                          width: 32px;
                          height: 32px;
                          line-height: 32px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 18px;
                          text-align: center;
                        "
                      >
                        ◎
                      </div>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 18px 0 0;
                    color: #000000;
                    font-size: 14px;
                    line-height: 22px;
                  "
                >
                  LifeLine Dispatch
                  <br />
                  Your trusted emergency ambulance dispatch platform
                </p>

                <p
                  style="
                    margin: 16px 0 0;
                    color: #8a8a8a;
                    font-size: 12px;
                    line-height: 18px;
                  "
                >
                  This is an automated email. Please do not reply to this
                  message.
                  <br />
                  © LifeLine Dispatch. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
