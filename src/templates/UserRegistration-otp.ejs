<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>LifeLine Dispatch - OTP Verification</title>

    <style>
      @media only screen and (max-width: 600px) {
        .email-container {
          width: 100% !important;
          max-width: 100% !important;
          border-radius: 0 !important;
        }

        .main-heading {
          font-size: 22px !important;
          line-height: 30px !important;
        }

        .otp-code {
          font-size: 32px !important;
          letter-spacing: 4px !important;
        }

        .body-text {
          font-size: 13px !important;
          line-height: 21px !important;
        }
      }
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      role="presentation"
      style="width: 100%; background-color: #ffffff"
    >
      <tr>
        <td align="center" style="padding: 20px 10px">
          <!-- Main Email -->
          <table
            width="600"
            border="0"
            cellspacing="0"
            cellpadding="0"
            role="presentation"
            style="
              width: 100%;
              max-width: 600px;
              background-color: #f3f4fa;
              border-radius: 8px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td style="padding: 18px 20px 0 20px">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                >
                  <tr>
                    <!-- Brand -->
                    <td align="left" valign="middle">
                      <table
                        border="0"
                        cellspacing="0"
                        cellpadding="0"
                        role="presentation"
                      >
                        <tr>
                          <!-- Logo -->
                          <td valign="middle" style="padding-right: 10px">
                            <table
                              width="40"
                              height="40"
                              border="0"
                              cellspacing="0"
                              cellpadding="0"
                              role="presentation"
                              style="
                                width: 40px;
                                height: 40px;
                                background-color: #7c3aed;
                                border-radius: 9px;
                              "
                            >
                              <tr>
                                <td
                                  align="center"
                                  valign="middle"
                                  style="
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                  "
                                >
                                  LD
                                </td>
                              </tr>
                            </table>
                          </td>

                          <!-- Brand Name -->
                          <td
                            valign="middle"
                            style="
                              color: #191355;
                              font-size: 17px;
                              font-weight: 700;
                              line-height: 16px;
                            "
                          >
                            LifeLine Dispatch
                          </td>
                        </tr>
                      </table>
                    </td>

                    <!-- Date -->
                    <td
                      align="right"
                      valign="top"
                      style="
                        padding-top: 12px;
                        color: #a3a3a3;
                        font-size: 11px;
                        font-weight: 600;
                      "
                    >
                      <%= new Date().toLocaleDateString("en-GB") %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Heading -->
            <tr>
              <td align="center" style="padding: 42px 25px 34px 25px">
                <div
                  style="
                    margin: 0;
                    color: #08275d;
                    font-size: 20px;
                    line-height: 15px;
                    font-weight: 700;
                  "
                >
                  Your One-Time Password
                </div>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td
                style="
                  padding: 0 34px;
                  color: #000000;
                  font-size: 14px;
                  line-height: 1.7;
                "
              >
                <p style="margin: 0 0 10px 0">
                  Dear <strong><%= name %></strong>,
                </p>

                <p style="margin: 0 0 8px 0">
                  Here is your One-Time Password to securely verify your PH
                  Healthcare account:
                </p>

                <p style="margin: 0; color: #666666; font-size: 12px">
                  Verification email:
                  <strong><%= email %></strong>
                </p>
              </td>
            </tr>

            <!-- OTP -->
            <tr>
              <td align="center" style="padding: 25px 20px 25px 20px">
                <div
                  style="
                    color: #08275d;
                    font-size: 28px;
                    line-height: 37px;
                    font-weight: 700;
                    letter-spacing: 5px;
                  "
                >
                  <%= otp %>
                </div>
              </td>
            </tr>

            <!-- OTP Expiry -->
            <tr>
              <td
                align="center"
                style="
                  padding: 0 20px 20px 20px;
                  color: #222222;
                  font-size: 14px;
                  line-height: 22px;
                "
              >
                Note: This OTP is valid for
                <strong><%= expirationMinutes %> minutes</strong>.
              </td>
            </tr>

            <!-- Security Message -->
            <tr>
              <td
                style="
                  padding: 0 28px;
                  color: #000000;
                  font-size: 14px;
                  line-height: 1.7;
                "
              >
                <p style="margin: 0 0 14px 0">
                  If you did not request this OTP, please disregard this email
                  or contact our support team.
                </p>

                <p style="margin: 0 0 38px 0">
                  Thank you for using LifeLine Dispatch !
                </p>

                <p style="margin: 0 0 20px 0">Team LifeLine Dispatch.</p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0">
                <div
                  style="width: 100%; height: 1px; background-color: #a7a7a7"
                ></div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 20px 20px 28px 20px">
                <!-- Social Icons -->
                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                  style="margin: 0 auto"
                >
                  <tr>
                    <td style="padding: 0 5px">
                      <div
                        style="
                          width: 29px;
                          height: 29px;
                          line-height: 29px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 17px;
                          font-weight: 700;
                          text-align: center;
                        "
                      >
                        f
                      </div>
                    </td>

                    <td style="padding: 0 5px">
                      <div
                        style="
                          width: 29px;
                          height: 29px;
                          line-height: 29px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 12px;
                          text-align: center;
                        "
                      >
                        ▶
                      </div>
                    </td>

                    <td style="padding: 0 5px">
                      <div
                        style="
                          width: 29px;
                          height: 29px;
                          line-height: 29px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 13px;
                          font-weight: 700;
                          text-align: center;
                        "
                      >
                        in
                      </div>
                    </td>

                    <td style="padding: 0 5px">
                      <div
                        style="
                          width: 29px;
                          height: 29px;
                          line-height: 29px;
                          background-color: #7587a8;
                          border-radius: 50%;
                          color: #ffffff;
                          font-size: 17px;
                          font-weight: 700;
                          text-align: center;
                        "
                      >
                        ◎
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Contact -->
                <p
                  style="
                    margin: 17px 0 0 0;
                    color: #000000;
                    font-size: 13px;
                    line-height: 20px;
                  "
                >
                  Website: LifeLine Dispatch &nbsp;|&nbsp; Support: Healthcare
                  Support
                  <br />
                  Your trusted emergency ambulance dispatch platform
                </p>

                <!-- Store Buttons -->
                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  role="presentation"
                  style="margin: 18px auto 0 auto"
                >
                  <tr>
                    <td style="padding: 0 3px">
                      <div
                        style="
                          padding: 7px;
                          background-color: #000000;
                          border-radius: 4px;
                          color: #ffffff;
                          font-size: 8px;
                          line-height: 12px;
                        "
                      >
                        Download on the
                        <br />
                        <strong style="font-size: 12px">App Store</strong>
                      </div>
                    </td>

                    <td style="padding: 0 3px">
                      <div
                        style="
                          padding: 7px;
                          background-color: #000000;
                          border-radius: 4px;
                          color: #ffffff;
                          font-size: 8px;
                          line-height: 12px;
                        "
                      >
                        GET IT ON
                        <br />
                        <strong style="font-size: 12px">Google Play</strong>
                      </div>
                    </td>

                    <td style="padding: 0 3px">
                      <div
                        style="
                          padding: 7px;
                          background-color: #000000;
                          border-radius: 4px;
                          color: #ffffff;
                          font-size: 8px;
                          line-height: 12px;
                        "
                      >
                        Get it from
                        <br />
                        <strong style="font-size: 11px">Microsoft Store</strong>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Copyright -->
                <p
                  style="
                    margin: 18px 0 0 0;
                    color: #8b8b8b;
                    font-size: 11px;
                    line-height: 16px;
                  "
                >
                  © LifeLine Dispatch. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
          <!-- End Main Email -->
        </td>
      </tr>
    </table>
  </body>
</html>
